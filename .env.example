# ─────────────────────────────────────────────────────────────────────────────
# MLO WANGU — Environment Variables (names only, never commit actual values)
# Copy to .env and fill in real values before running.
# .env is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for production) ──────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL="https://your-project.supabase.co"

# Anon/public key — safe for server-side auth validation (respects RLS)
SUPABASE_ANON_KEY="eyJ..."

# Service role key — bypasses RLS; ONLY used server-side for admin operations.
# NEVER expose to the browser or frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# JWT secret — from Supabase dashboard → Settings → API → JWT Settings
# Used for fast local JWT verification without a Supabase network call.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ── Gemini AI (server-side only) ─────────────────────────────────────────────
# Rotate if previously exposed. Never use VITE_ prefix.
GEMINI_API_KEY="your-gemini-api-key"

# ── Application ──────────────────────────────────────────────────────────────
# Canonical URL of the deployed app (used for CORS, email links, OAuth redirect)
APP_URL="https://your-app.vercel.app"
NODE_ENV="development"

# ── M-Pesa / Safaricom Daraja (production payments) ──────────────────────────
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_PASSKEY="your-daraja-passkey"
MPESA_SHORTCODE="your-paybill-or-till"
MPESA_CALLBACK_URL="https://your-app.vercel.app/api/payments/mpesa/callback"
# Must be exactly "sandbox" or "production" — never defaulted, so a
# misconfigured deploy can't silently send transactions in the wrong mode.
MPESA_ENVIRONMENT="sandbox"

# Till (Buy Goods) number for the manual-entry payment method — separate
# from MPESA_SHORTCODE above (that's the Paybill/STK-push shortcode). Purely
# a display value shown to the user; not used to call Daraja at all, since
# this payment method is never auto-verified.
MPESA_TILL_NUMBER="your-till-number"

# ── Email (access-code delivery — not required unless you want this feature
# live; without it, sendEmail() fails closed and email_log rows are written
# as 'not_configured' rather than blocking any payment/access-code flow) ────
# API key from your Resend account (https://resend.com).
RESEND_API_KEY="your-resend-api-key"
# Sender address — must be on a domain verified in that Resend account, or
# sends will fail (logged to email_log, never thrown).
EMAIL_FROM_ADDRESS="Mlo Wangu <noreply@yourdomain.com>"

# ── Development fallback ──────────────────────────────────────────────────────
# Set USE_JSON_DB=true to use the local JSON database instead of Supabase.
# Useful for running locally without Supabase credentials.
# Never set this in production.
USE_JSON_DB="true"
